# Environment variables — copy this to .env and fill in the values

# ── GitHub OAuth App ───────────────────────────────────────────────────────────
# Create one at: github.com/settings/developers → OAuth Apps → New OAuth App
# Callback URL (dev): http://localhost:3001/auth/callback
GITHUB_CLIENT_ID=your_github_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret

# ── Session ────────────────────────────────────────────────────────────────────
SESSION_SECRET=any_long_random_string_at_least_32_chars

# ── Server ─────────────────────────────────────────────────────────────────────
# Optional: override the port (defaults to 3001 in dev, 8080 in prod)
PORT=3001

# Frontend URL (used for CORS and OAuth redirect in development)
FRONTEND_URL=http://localhost:5173

# ── AI API keys ────────────────────────────────────────────────────────────────
# No AI API key is stored on the server — each user inserts their own key
# directly in the browser UI. Keys live only in sessionStorage and are never
# persisted on the backend.
#
# Supported providers and their free-tier models:
#
#   Google Gemini → https://aistudio.google.com/apikey  (key starts with AIza...)
#     • gemini-2.5-flash, gemini-2.5-pro, gemini-3.5-flash, ...
#
#   Groq Cloud → https://console.groq.com  (key starts with gsk_...)
#     • llama-3.1-8b-instant, llama-3.3-70b-versatile, gemma2-9b-it,
#       llama3-70b-8192, llama3-8b-8192, mixtral-8x7b-32768
#
#   OpenRouter → https://openrouter.ai/keys
#     • deepseek-r1:free, llama-3.3-70b-instruct:free, gemini-2.0-flash-exp:free,
#       gemma-2-9b-it:free, qwen-2.5-7b-instruct:free, mistral-7b-instruct:free,
#       hermes-3-llama-3.1-8b:free
