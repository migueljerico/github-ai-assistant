# Environment variables — copy this to .env and fill in the values

# ── GitHub OAuth App ───────────────────────────────────────────────────────────
# Create one at: github.com/settings/developers → OAuth Apps → New OAuth App
# Callback URL (dev): http://localhost:3001/auth/callback
GITHUB_CLIENT_ID=your_github_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret

# ── Session ────────────────────────────────────────────────────────────────────
SESSION_SECRET=any_long_random_string_at_least_32_chars

# ── Server ─────────────────────────────────────────────────────────────────────
# Optional: override the port (defaults to 3001 in dev, 8080 in prod)
PORT=3001

# Frontend URL (used for CORS and OAuth redirect in development)
FRONTEND_URL=http://localhost:5173

# ── AI API keys ────────────────────────────────────────────────────────────────
# No AI API key is stored on the server. Each user inserts their own key directly
# in the browser UI. Keys live only in React state (Zero-Storage) and are NEVER
# persisted on the backend, sessionStorage, localStorage or logs.
#
# Supported providers (10). Catalogs are dynamic where the provider exposes a
# public /models endpoint; otherwise a curated static fallback is used.
#
#   Google Gemini → https://aistudio.google.com/apikey  (key starts with AIza...)
#     Static catalog (GEMINI_MODELS) + dynamic via /api/gemini/models proxy.
#
#   Groq Cloud → https://console.groq.com  (key starts with gsk_...)
#     Dynamic catalog (api.groq.com/openai/v1/models), direct from browser.
#
#   OpenRouter → https://openrouter.ai/keys
#     Dynamic catalog (openrouter.ai/api/v1/models, public, no key), direct.
#
#   NVIDIA NIM → https://build.nvidia.com  (key starts with nvapi-...)
#     Static catalog (NIM_FALLBACK) + dynamic via /api/nim/models proxy.
#
#   Zenmux → https://zenmux.ai  (key starts with sk-ai-v1-...)
#     Dynamic catalog (zenmux.ai/api/v1/models), direct. Free: DeepSeek V4 Flash,
#     Ling 3.0 Flash, GLM 4.7/4.6V Flash.
#
#   OpenCode Zen → https://opencode.ai/docs/es/zen/  (key: public)
#     Static catalog (OPENZEN_FALLBACK), free models with "-free" suffix. Via /api/openzen proxy.
#
#   Cloudflare Workers AI → https://dash.cloudflare.com/profile/api-tokens
#     (token + Account ID). Dynamic catalog via /api/cloudflare/models proxy.
#     Free plan: 10 000 Neurons/day. Recommended (low usage): Qwen3 30B.
#     Avoid Kimi/GLM 5.2 (require Workers Paid).
#
#   Ollama Cloud → https://ollama.com  (key starts with sk-ollama-...)
#     Static catalog (OLLAMA_FALLBACK) + dynamic via /api/ollama/models proxy.
#
#   Ai& → https://aiand.com  (key starts with sk-...)
#     Dynamic catalog (api.aiand.com), free-only, via /api/aiand proxy.
#
#   Kilo → https://kilo.ai  (key starts with sk-...)
#     Dynamic catalog (public), free models with ":free" suffix. Via /api/kilo proxy.
