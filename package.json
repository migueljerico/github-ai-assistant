{
  "name": "github-ai-assistant",
  "version": "4.0.10",
  "description": "Un asistente de IA que lee repositorios de GitHub sin necesidad de clonarlos",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node --env-file=.env server/index.js",
    "dev:server": "node --env-file=.env --watch server/index.js",
    "dev:client": "cd client && npm run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build": "cd client && npm run build",
    "deploy": "bash deploy.sh",
    "postinstall": "",
    "test:coverage": "vitest run --coverage",
    "test:server": "vitest run server",
    "test:e2e": "playwright test",
    "test:e2e:full": "npm run build && playwright test"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "express-session": "^1.17.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "concurrently": "^10.0.4",
    "supertest": "^7.0.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "shell-quote": ">=1.9.0"
  },
  "engines": {
    "node": ">=20"
  }
}
