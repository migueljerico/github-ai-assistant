{
  "name": "github-ai-assistant",
  "version": "3.15.0",
  "description": "Asistente de IA para Publicar Repositorios",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node --env-file=.env server/index.js",
    "dev:server": "node --env-file=.env --watch server/index.js",
    "dev:client": "cd client && npm run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build": "cd client && npm run build",
    "postinstall": "",
    "test:coverage": "vitest run --coverage",
    "test:server": "vitest run server"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.17.3"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "supertest": "^7.0.0",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
